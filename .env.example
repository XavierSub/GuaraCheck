# Copie para .env (local) ou cadastre no painel da hospedagem (produção)
SECRET_KEY=troque-por-uma-sequencia-longa-e-aleatoria
DATABASE_URL=
DOMINIO_ALUNOS=alunos.unicerrado.edu.br
DOMINIOS_PROFESSORES=unicerrado.edu.br
# Chave de Acesso Master da coordenação (sem ela, ninguém cria conta de professor)
CHAVE_MASTER=
# Cursos extras além da lista padrão, separados por vírgula
CURSOS_EXTRAS=
PRECISAO_MAX_M=150
# Anti-VPN: precisa de uma chave gratuita do proxycheck.io. Sem PROXYCHECK_KEY a verificação fica desligada.
# Modos: off | avisar (só registra alerta) | bloquear (recusa o check-in e lista em "Tentativas recusadas")
PROXYCHECK_KEY=
VPN_MODO=bloquear
PROXY_HOPS=1
# IPs/redes do campus que nunca são checados, ex.: 200.1.2.3,200.1.2.0/24
IPS_PERMITIDOS=
# Coordenação: é uma aba na tela inicial. O PRIMEIRO acesso usa a CHAVE_MASTER (só enquanto não existir nenhuma
# conta da coordenação); depois, a coordenação cria as outras contas na aba Professores do painel.
# ADMIN_EMAILS é opcional: e-mails (separados por vírgula) que sempre são da coordenação.
ADMIN_EMAILS=
# Endereço extra que abre a tela já na aba Coordenação (além de /coordenacao)
ADMIN_PATH=coordenacao
# Conta PROVISÓRIA da coordenação (opcional): só é criada se COORD_SENHA estiver preenchida E ainda não existir nenhuma
# conta da coordenação. NÃO há senha padrão no código. Defina COORD_SENHA só na hospedagem (Render), nunca aqui no GitHub,
# e troque a senha logo em Resumo > "Trocar minha senha". Sem COORD_SENHA, o primeiro acesso é pela aba Coordenação,
# com a CHAVE_MASTER. COORD_PROVISORIA=0 desliga.
COORD_PROVISORIA=1
COORD_EMAIL=coordenacao355@unicerrado.edu.br
COORD_SENHA=
# Freio do cadastro de aluno por IP (padrão: 100 contas novas por hora). Alto de propósito, por causa do Wi-Fi do campus;
# redes listadas em IPS_PERMITIDOS não entram na conta.
CADASTRO_ALUNO_MAX=100
CADASTRO_ALUNO_JANELA_S=3600
# Login da coordenação (só falhas contam): por IP, por conta+IP e teto geral por conta por hora.
ADMIN_FALHAS_IP=10
ADMIN_FALHAS_CONTA=8
ADMIN_FALHAS_GERAL_HORA=100
# Confirmação do e-mail por código (cadastro de aluno e de professor). O cadastro só vira conta depois que a pessoa digita o
# código de 6 números enviado ao e-mail institucional: impede cadastrar o e-mail de outra pessoa.
# A Render (plano gratuito) bloqueia SMTP, então o padrão é o Brevo por API HTTPS (conta gratuita: 300 e-mails/dia).
# Passo a passo: crie a conta no Brevo > "SMTP e API" > crie uma chave de API > em "Remetentes" cadastre e verifique o endereço
# que vai enviar. Prefira um endereço da UniCerrado (a TI da instituição precisa liberar SPF/DKIM do domínio); remetente de
# e-mail gratuito (gmail etc.) cai no spam. Defina EMAIL_API_KEY só na Render, nunca no GitHub.
# VERIFICAR_EMAIL: auto = liga sozinho quando o provedor estiver configurado | 1 = obrigatório (sem provedor, o cadastro
# fica indisponível em vez de aceitar sem confirmar) | 0 = desligado.
EMAIL_PROVEDOR=
EMAIL_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Guará Check
VERIFICAR_EMAIL=auto
# Só se um dia sair do plano gratuito da Render (EMAIL_PROVEDOR=smtp):
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Validade do código (minutos), tentativas erradas por código, espera entre envios (s) e envios por hora (por e-mail e IP)
CODIGO_EMAIL_MIN=15
CODIGO_MAX_TENTATIVAS=5
CODIGO_INTERVALO_S=30
CODIGO_ENVIOS_HORA=5
# Freio de códigos errados por IP (10 min). Só erros contam.
CONFIRMA_FALHAS_IP=40
# Matrículas: com MATRICULA_OBRIGATORIA=1 o aluno só cria conta se a matrícula estiver na lista autorizada
# (coordenação > aba Matrículas). Padrão: 0 (desligado por enquanto; aceita qualquer matrícula numérica válida).
MATRICULA_OBRIGATORIA=0
# Formato aceito da matrícula (expressão regular). Padrão: letras e números, de 4 a 30 caracteres (ex.: 202610405 ou GTI202610405).
MATRICULA_REGEX=^[A-Za-z0-9][A-Za-z0-9._/-]{3,29}$
# Limpeza única dos dados de teste (apaga alunos, professores, aulas, presenças, matrículas e auditoria; mantém os cursos).
# Preencha com qualquer texto (ex.: limpar1) para apagar na próxima inicialização. Roda uma vez por valor; para repetir, troque o valor.
RESET_BANCO=
